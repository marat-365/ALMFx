{
  "$schema": "https://developer.microsoft.com/json-schemas/spfx-build/config.2.0.schema.json",
  "version": "2.0",
  "bundles": {
    "hello-world-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/helloWorld/HelloWorldWebPart.js",
          "manifest": "./src/webparts/helloWorld/HelloWorldWebPart.manifest.json"
        }
      ]
    },
    "header-footer-application-customizer": {
      "components": [
        {
          "entrypoint": "./lib/extensions/headerFooter/HeaderFooterApplicationCustomizer.js",
          "manifest": "./src/extensions/headerFooter/HeaderFooterApplicationCustomizer.manifest.json"
        }
      ]
    },
    "color-coded-field-customizer": {
      "components": [
        {
          "entrypoint": "./lib/extensions/colorCoded/ColorCodedFieldCustomizer.js",
          "manifest": "./src/extensions/colorCoded/ColorCodedFieldCustomizer.manifest.json"
        }
      ]
    },
    "item-actions-command-set": {
      "components": [
        {
          "entrypoint": "./lib/extensions/itemActions/ItemActionsCommandSet.js",
          "manifest": "./src/extensions/itemActions/ItemActionsCommandSet.manifest.json"
        }
      ]
    },
    "shared-utilities-library": {
      "components": [
        {
          "entrypoint": "./lib/index.js",
          "manifest": "./src/libraries/sharedUtilities/SharedUtilitiesLibrary.manifest.json"
        }
      ]
    },
    "sample-card-adaptive-card-extension": {
      "components": [
        {
          "entrypoint": "./lib/adaptiveCardExtensions/sampleCard/SampleCardAdaptiveCardExtension.js",
          "manifest": "./src/adaptiveCardExtensions/sampleCard/SampleCardAdaptiveCardExtension.manifest.json"
        }
      ]
    }
  },
  "externals": {},
  "localizedResources": {
    "HelloWorldWebPartStrings": "lib/webparts/helloWorld/loc/{locale}.js",
    "HeaderFooterApplicationCustomizerStrings": "lib/extensions/headerFooter/loc/{locale}.js",
    "ColorCodedFieldCustomizerStrings": "lib/extensions/colorCoded/loc/{locale}.js",
    "ItemActionsCommandSetStrings": "lib/extensions/itemActions/loc/{locale}.js",
    "SharedUtilitiesLibraryStrings": "lib/libraries/sharedUtilities/loc/{locale}.js",
    "SampleCardAdaptiveCardExtensionStrings": "lib/adaptiveCardExtensions/sampleCard/loc/{locale}.js"
  }
}
