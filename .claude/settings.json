{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(pwsh -File ./build/Invoke-Build.ps1:*)",
      "Bash(npm ci)",
      "Bash(npm run lint:*)",
      "Bash(npm test:*)"
    ],
    "deny": [
      "Read(./**/*.pfx)",
      "Read(./**/*.pem)",
      "Read(./**/.env)",
      "Read(./**/.env.*)"
    ]
  }
}
